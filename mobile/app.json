{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.academy.pallo"
    },
    "android": {
      "package": "com.academy.pallo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "말하기 문제에서 내 목소리를 듣고 채점하려면 마이크가 필요해요.",
          "speechRecognitionPermission": "말한 영어를 글자로 바꿔 채점하려면 음성 인식이 필요해요."
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "출석 QR을 찍거나 올릴 사진을 찍으려면 카메라가 필요해요.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "라운지 · 챌린지에 올릴 사진을 고르려면 사진 접근이 필요해요.",
          "cameraPermission": "출석 QR을 찍거나 올릴 사진을 찍으려면 카메라가 필요해요."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 지점을 거리순으로 보여 드리려면 현재 위치가 필요해요. 위치는 저장하지 않아요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "api": {
        "env": "dev",
        "baseUrls": {
          "dev": "",
          "staging": "",
          "prod": ""
        },
        "mock": true,
        "mockDelayMs": 0
      }
    }
  }
}
