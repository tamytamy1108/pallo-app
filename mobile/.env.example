# pallo-app 로컬 설정 예시 — 이 파일을 .env.local 로 복사해서 값을 채워요 (.env.local 은 git 에 안 올라가요).
# EXPO_PUBLIC_ 값은 빌드할 때 앱에 그대로 들어가요 — 공개돼도 되는 값만 둬요.
# 카카오 client secret · 어드민 키 · 앱 id 는 여기 두지 않아요 (백엔드 설정이에요).

# ── 서버 ──────────────────────────────────────────────
# 0 = 실제 서버, 1 = 가짜 데이터(mock). 비우면 app.json extra.api.mock 을 따라요
EXPO_PUBLIC_API_MOCK=1
# dev | staging | prod — EXPO_PUBLIC_API_BASE_URL 이 없을 때 app.json baseUrls 중 무엇을 쓸지
EXPO_PUBLIC_API_ENV=dev
# 서버 오리진만 (경로 /app/api/v2 는 앱이 붙여요). 폰 실기기는 localhost 대신 PC 의 사설 IP
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ── 카카오 로그인 ─────────────────────────────────────
# 폰(카카오 SDK) — 카카오 디벨로퍼스 › 앱 키 › 네이티브 앱 키. 바꾸면 개발 빌드를 다시 만들어야 해요
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 웹 미리보기 — REST API 키 (백엔드 kakao.rest-api-key 와 같은 값)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# 웹 미리보기 콜백 — 백엔드 kakao.redirect-uri · 카카오 콘솔 Redirect URI 와 한 글자도 다르면 안 돼요
EXPO_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:8081/auth/kakao/callback
